.npmrc
.netrc
.pypirc
.git-credentials
service-account*.json
google-services.json
*.tfvars
# ADB and wireless-debugging identity (private key, pairing data)
adbkey
adbkey.pub
.android/
# Claude/Codex local settings and MCP configs can hold tokens
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md
.mcp.json
.codex/
# PC adapter owner records, grants and service state (live runtime, never the repo)
live-operation.json
grants*.json
windows-service/
state.json
state.json.lock
service.json
