# Dependencies, local build products, and scratch data
node_modules/
.cache/
build/
dist/
artifacts/
# Build output only: upstream Desktop has a source folder app/artifacts that must be tracked.
!vendor/**/artifacts/
runtime/
verification/
coverage/
*.log
*.tsbuildinfo
__pycache__/
*.py[cod]

# Credentials and signing material must never enter Git
.env
.env.*
!.env.example
*.private.json
*.local.json
auth.json
*credentials*.json
*secrets*.json
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.pem
*.key
*.p8
*.der
*.csr
*.asc
*.gpg
*.truststore
id_rsa*
id_ed25519*
